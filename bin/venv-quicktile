#!/bin/bash
set -e
set -u
set -o pipefail
set -x
: "${QUICKTILE_DEST:=${1:-$HOME/.venv-quicktile}}"
Main() {
	if ! InstQT; then
		sudo apt install -y python3 python3-pip python3-setuptools python3-gi python3-xlib python3-dbus gir1.2-glib-2.0 gir1.2-gtk-3.0 gir1.2-wnck-3.0 
		# libdbus-1-dev libglib2.0-dev libcairo-dev libgirepository-2.0-dev
		InstQT
	fi
	mkdir -p ~/bin
	ln --symbolic --force --no-dereference --relative "$QUICKTILE_DEST/bin/quicktile" ~/bin
}
InstQT(){
	python3 -m venv --upgrade --system-site-packages  "$QUICKTILE_DEST"
	"$QUICKTILE_DEST/bin/pip3" install https://github.com/ssokolow/quicktile/archive/master.zip
}
Main "$@"
