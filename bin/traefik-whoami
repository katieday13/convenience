#!/bin/bash
# Script to install caddy-docker-proxy per https://github.com/lucaslorentz/caddy-docker-proxy
# TODO maybe update wg-easy to use it
set -e -u -o pipefail
set -x
: "${CDIR:=/etc/docker/containers}"
: "${EXT_HOSTNAME:=${1:-whoami.example.com}}"
Main() {
	Docker
	TraefikWhoami
	exit 0
}
Docker() {
	if ! [ -x /usr/bin/docker ]; then
		curl -sSL https://get.docker.com | sh
	fi
	# https://docs.docker.com/engine/install/linux-postinstall/#manage-docker-as-a-non-root-user
	local groups
	groups=$(sudo -u "$LOGNAME" id --groups --name)
	if [ "$groups" == "${groups##* docker }" ]; then
		sudo adduser "$LOGNAME" docker
	fi
}

TraefikWhoami() {
	local dir="${CDIR}/traefik-whoami"
	sudo mkdir --parents "$dir"
	sudo docker network create caddy
	sudo tee "$dir/docker-compose.yml" > /dev/null << EEOOTT
# Original from https://github.com/lucaslorentz/caddy-docker-proxy
# The whoami example
services:
  whoami:
    image: traefik/whoami
    networks:
      - caddy
    labels:
      caddy: $EXT_HOSTNAME
      caddy.reverse_proxy: "{{upstreams 80}}"

networks:
  caddy:
    external: true
EEOOTT
	(cd "$dir" && sudo -u "$LOGNAME" docker compose up --detach --wait)
}

Main "$@" 
# shellcheck disable=SC2317 # This is a persistent NFS catch-al
exit 1
