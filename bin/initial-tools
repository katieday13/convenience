#!/bin/bash
#shellcheck enable=all
set -e -u -o pipefail
set -x
case "${EUID}" in
	0) _s="";;
	*) _s="sudo";;
esac
zerodir="${0%/*}"
confdir="${zerodir}/../conf"
arch=$(dpkg --print-architecture)
# shellcheck disable=SC1091,SC2154
release=$(. /etc/os-release && echo "${DEBIAN_CODENAME:-${VERSION_CODENAME}}")
std_actions=()
actions=()
Main(){
	local subgroup action actions=()
	for subgroup in "$@"; do
		# Shellcheck doesn't like ${subgroup^} magic... so have an explicit case
		case "${subgroup}" in
			std) actions+=("${std_actions[@]}");;
			*) actions+=("${subgroup^}")
		esac
	done
	for action in "${actions[@]}"; do
		case "${action}" in
			Asdf) Asdf;;
			Distro) Distro;;
			Docker) Docker;;
			Brave) Brave;;
			Firefox) Firefox;;
			Git) Git;;
			Paperless) Paperless;;
			Remote) Remote;;
			Signal) Signal;;
			Uremote) Uremote;;
			VSCode) VSCode;;
			Vagrant) Vagrant;;
			VirtualBox) VirtualBox;;
			*) echo "oops ${action}";;
		esac
	done
	exit 0
}
Sudo(){
	${_s:+${_s}} "$@"
}
std_actions+=(Asdf)
actions+=(Asdf)
Asdf(){
	# This is shamelessly Debian specific
	local line asdf_version='v0.14.1' asdf_pre_reqs=(
		# asdf
		'curl'
		'git'
		# python from https://github.com/python/cpython/blob/main/.github/workflows/posix-deps-apt.sh
		'build-essential'
		'pkg-config'
		'ccache'
		'gdb'
		'lcov'
		'libb2-dev'
		'libbz2-dev'
		'libffi-dev'
		'libgdbm-dev'
		'libgdbm-compat-dev'
		'liblzma-dev'
		'libncurses5-dev'
		'libreadline6-dev'
		'libsqlite3-dev'
		'libssl-dev'
		'lzma'
		'lzma-dev'
		'strace'
		'tk-dev'
		'uuid-dev'
		'xvfb'
		'zlib1g-dev'
	) 
	# shellcheck disable=SC2016
	local asdf_bashrc_lines=(
		'. "$HOME/.asdf/asdf.sh"' 
		'. "$HOME/.asdf/completions/asdf.bash"'
	)
	local tool_versions=(
		'awscli latest'
		'direnv latest'
		'github-cli latest'
		'golang latest'
		'hadolint latest'
		'jq latest'
		'nodejs latest'
		'nodejs latest:22.'
		'packer latest'
		'python latest'
		'python latest:3.12.'
		'shellcheck latest'
		'yq latest'
		'yt-dlp latest'
		'zola latest'
	)
	Sudo apt-get install -y "${asdf_pre_reqs[@]}"
	git clone https://github.com/asdf-vm/asdf.git ~/.asdf --branch="${asdf_version}" || :
	(cd ~/.asdf; git checkout -b "${asdf_version}" || :) 
	# Technically unsafe... don't care
	# shellcheck disable=SC2094
	for line in "${asdf_bashrc_lines[@]}"; do
		# shellcheck disable=SC2094
		grep "^${line}$" "${HOME}/.bashrc" || echo "${line}"
	done >> "${HOME}/.bashrc"
	# shellcheck source=/dev/null
	. ~/.asdf/asdf.sh
	for line in "${tool_versions[@]}"; do
		asdf plugin add "${line%% *}"
		asdf install ${line:+${line}}
		asdf global ${line:+${line}}
	done
}
std_actions+=(Distro)
actions+=(Distro)
Distro(){
	Sudo apt-get update
	Sudo apt-get install -y lsscsi pandoc pass poppler-utils pwgen scsitools tomb uptimed uuid vim-nox
	Sudo update-alternatives --set vim /usr/bin/vim.nox
	Sudo update-alternatives --set editor /usr/bin/vim.nox
	PassUpdate
	# Brave
}
PassUpdate(){
	mkdir -p ~/gh
	rm -rf ~/gh/pass-update
	git clone https://github.com/roddhjav/pass-update/ ~/gh/pass-update
	(cd ~/gh/pass-update; Sudo make install)
}
actions+=(Brave)
Brave(){
	curl -fsS https://dl.brave.com/install.sh | sh
}

actions+=(Signal)
Signal(){
	# https://signal.org/download/linux/
	# 1. Install our official public software signing key:
	wget -O- https://updates.signal.org/desktop/apt/keys.asc | gpg --dearmor |
	Sudo tee /usr/share/keyrings/signal-desktop-keyring.gpg > /dev/null 

# 2. Add our repository to your list of repositories:
	echo 'deb [arch=amd64 signed-by=/usr/share/keyrings/signal-desktop-keyring.gpg] https://updates.signal.org/desktop/apt xenial main' |\
  	Sudo tee /etc/apt/sources.list.d/signal-xenial.list

# 3. Update your package database and install Signal:
	Sudo apt update
	Sudo apt install signal-desktop
}
std_actions+=(Docker)
actions+=(Docker)
Docker(){
	# Again shamelessly debian
	Sudo rm -f /etc/apt/sources.list.d/docker.list
	Sudo apt-get update
	Sudo apt-get install -y ca-certificates curl
	Sudo install -m 0755 -d /etc/apt/keyrings
	Sudo curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
	Sudo chmod a+r /etc/apt/keyrings/docker.asc
	echo \
		"deb [arch=${arch} signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian \
		${release} stable" | \
		Sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
	Sudo apt-get update
	Sudo apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
	Sudo adduser "${LOGNAME}" docker
}

std_actions+=(Firefox)
actions+=(Firefox)
Firefox() {
	Sudo install -d -m 0755 /etc/apt/keyrings
	wget -q https://packages.mozilla.org/apt/repo-signing-key.gpg -O- | Sudo tee /etc/apt/keyrings/packages.mozilla.org.asc > /dev/null
	wget -q https://packages.mozilla.org/apt/repo-signing-key.gpg -O- | sudo tee /etc/apt/keyrings/packages.mozilla.org.asc > /dev/null
	echo "deb [signed-by=/etc/apt/keyrings/packages.mozilla.org.asc] https://packages.mozilla.org/apt mozilla main" | sudo tee -a /etc/apt/sources.list.d/mozilla.list > /dev/null
	echo '
Package: *
Pin: origin packages.mozilla.org
Pin-Priority: 1000
' | Sudo tee /etc/apt/preferences.d/mozilla 
	Sudo apt-get update
	Sudo apt-get install -y firefox firefox-esr

}

actions+=(Paperless)
Paperless() {
	Docker
	curl --location --silent --show-error -o /tmp/install-paperless-ngx.sh
	bash /tmp/install-paperless-ngx.sh
	rm -f /tmp/install-paperless-ngx.sh
	# bash -c "$(curl --location --silent --show-error https://raw.githubusercontent.com/paperless-ngx/paperless-ngx/main/install-paperless-ngx.sh)"
}

std_actions+=(VSCode)
actions+=(VSCode)
VSCode(){
	curl -L -o /tmp/vscode.deb 'https://code.visualstudio.com/sha/download?build=stable&os=linux-deb-x64'
	Sudo apt-get install -y /tmp/vscode.deb
}

actions+=(Git)
Git(){
	local email name
	git config --global push.autoSetupRemote true
	if ! git config --get --global init.defaultBranch; then
		git config --global initdefaultBranch canonical
	fi
	if ! git config --get user.email; then
		read -r -p "What email are you gonna use for git?" email
		git config --global user.email "${email}"
	fi
	if ! git config --get user.name; then
		read -r -p "What name are you gonna use for git?" name
		git config --global user.name "${name}"
	fi
}

std_actions+=(Vagrant)
actions+=(Vagrant)
Vagrant(){
	VirtualBox
	wget -O - https://apt.releases.hashicorp.com/gpg |
		Sudo gpg --dearmor --batch --yes -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
	echo "deb [arch=${arch} signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com ${release} main" | Sudo tee /etc/apt/sources.list.d/hashicorp.list
	Sudo apt-get update
	Sudo apt-get install -y vagrant libvirt-dev qemu-kvm libvirt-daemon-system
}

# Implicit from Vagrant
# std_actions+=(Virtualbox)
actions+=(Virtualbox)
VirtualBox(){
	curl -L -o /tmp/virtualbox.deb 'https://download.virtualbox.org/virtualbox/7.1.6/virtualbox-7.1_7.1.6-167084~Debian~bookworm_amd64.deb'
	Sudo apt-get install -y /tmp/virtualbox.deb
}

std_actions+=(Remote)
actions+=(Remote)
Remote(){
	Sudo apt-get update
	Sudo apt-get install -y fwknop-server fwknop-client wireguard wireguard-tools openssh-server
	Sudo ufw default deny incoming
	Sudo ufw default allow outgoing
	Sudo ufw enable
	Fwknopd
}

Fwknopd() {
	local d=/etc/fwknop conf
	local confs=(access.conf fwknopd.conf)
	Sudo mkdir -p "${d}/access.conf.d"
	for conf in "${confs[@]}"; do
		if [[ ! -r "${d}/${conf}.orig" ]]; then
			Sudo mv -v "${d}/${conf}" "${d}/${conf}.orig"
		fi
		Sudo install -m 0600 "${confdir}/${conf}" "${d}/${conf}"
	done
	FwknopdConf | Sudo tee /etc/fwknop/fwknopd.conf
	Sudo systemctl restart fwknop-server.service
	# Sudo /usr/sbin/fwknopd -f
}

FwknopdConf() {
	ip route show default | awk '{print "PCAP_INTF", $5 ";" }'
	echo "PCAP_FILTER udp dst portrange 62000-65535"
}

Uremote() {
	Sudo ufw default allow incoming
	Sudo ufw default allow outgoing
	Sudo ufw enable
}

Main "$@"
# shellcheck disable=SC2317
exit 1
